{
  "name": "comment-copilot-extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "dev:prod": "plasmo dev --env=.env.production",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.0",
    "lodash": "^4.17.23",
    "plasmo": "^0.86.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/lodash": "^4.17.24",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  },
  "manifest": {
    "name": "Comment Copilot",
    "description": "小红书评论区 AI 助手，自动采集评论并生成回复建议",
    "permissions": [
      "storage",
      "activeTab",
      "sidePanel",
      "tabs"
    ],
    "host_permissions": [
      "https://www.xiaohongshu.com/*",
      "https://www.douyin.com/*",
      "http://localhost:3000/*",
      "http://47.103.100.114:13000/*"
    ]
  }
}
